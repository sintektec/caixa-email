<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Aplicativo WinUI 3 em modo DUAL: o mesmo projeto gera o pacote MSIX e também roda
    unpackaged.

    A alternância é feita pela propriedade `Packaged`:
      dotnet build src/Sintek.Mail.App -p:Packaged=true   → MSIX
      dotnet build src/Sintek.Mail.App                     → unpackaged (padrão, para depurar)

    É por causa desse modo duplo que as credenciais usam CredRead/CredWrite em vez do
    PasswordVault: o PasswordVault exige identidade de pacote e falharia no modo unpackaged.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Sintek.Mail.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationIcon>Assets\Sintek.Mail.ico</ApplicationIcon>

    <!--
      O gerador de código XAML do WinUI ainda emite avisos que não controlamos; tratá-los
      como erro quebraria a build por código que não é nosso.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <PropertyGroup Condition="'$(Packaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Packaged)' == 'true'">
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>

  <ItemGroup Condition="'$(Packaged)' == 'true'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup Condition="'$(Packaged)' != 'true'">
    <!-- Sem identidade de pacote o manifesto MSIX não se aplica e confundiria a build. -->
    <None Remove="Package.appxmanifest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sintek.Mail.Domain\Sintek.Mail.Domain.csproj" />
    <ProjectReference Include="..\Sintek.Mail.Application\Sintek.Mail.Application.csproj" />
    <ProjectReference Include="..\Sintek.Mail.Persistence\Sintek.Mail.Persistence.csproj" />
    <ProjectReference Include="..\Sintek.Mail.Infrastructure\Sintek.Mail.Infrastructure.csproj" />
    <ProjectReference Include="..\Sintek.Mail.Infrastructure.Windows\Sintek.Mail.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="WinUIEx" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
