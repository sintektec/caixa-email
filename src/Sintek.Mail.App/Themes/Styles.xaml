<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Recursos próprios da aplicação.

        Deliberadamente enxuto: as cores e tipografia vêm do tema Fluent do WinUI, que já
        acompanha o modo claro/escuro e o alto contraste do Windows. Fixar cores aqui
        quebraria o alto contraste — exatamente o recurso de acessibilidade que a
        especificação manda respeitar.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DomainRestrictedFolderBrush" Color="#0F6CBD" />
            <SolidColorBrush x:Key="PendingSyncBrush" Color="#8A6B00" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DomainRestrictedFolderBrush" Color="#62ABF5" />
            <SolidColorBrush x:Key="PendingSyncBrush" Color="#F2C744" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!--
                Em alto contraste, as cores vêm do sistema: o usuário escolheu uma paleta
                específica justamente porque precisa dela.
            -->
            <SolidColorBrush x:Key="DomainRestrictedFolderBrush"
                             Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PendingSyncBrush"
                             Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="NavigationPaneMinWidth">200</x:Double>
    <x:Double x:Key="MessageListMinWidth">280</x:Double>
    <x:Double x:Key="ReadingPaneMinWidth">320</x:Double>

</ResourceDictionary>
