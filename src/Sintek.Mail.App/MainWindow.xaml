<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sintek.Mail.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sintek.Mail">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Command Bar -->
        <CommandBar Grid.Row="0">
            <AppBarButton Icon="Add" Label="Nova Conta" Command="{x:Bind ViewModel.AddAccountCommand}"/>
            <AppBarButton Icon="Refresh" Label="Sincronizar" Command="{x:Bind ViewModel.SyncCommand}"/>
            <AppBarButton Icon="Setting" Label="Configurações" Command="{x:Bind ViewModel.SettingsCommand}"/>
        </CommandBar>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Domains / Accounts -->
            <ListView Grid.Column="0" ItemsSource="{x:Bind ViewModel.Domains}" SelectedItem="{x:Bind ViewModel.SelectedDomain, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:DomainDirectoryDto">
                        <StackPanel Padding="8">
                            <TextBlock Text="{x:Bind DomainName}" FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Messages -->
            <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.Messages}" SelectedItem="{x:Bind ViewModel.SelectedMessage, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MessageDto">
                        <StackPanel Padding="8">
                            <TextBlock Text="{x:Bind FromAddress}" FontWeight="Bold"/>
                            <TextBlock Text="{x:Bind Subject}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Preview}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Reading Pane -->
            <WebView2 Grid.Column="2" x:Name="ReadingPane"/>
        </Grid>
    </Grid>
</Window>
