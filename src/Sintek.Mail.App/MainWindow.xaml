<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Sintek.Mail.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Sintek.Mail.Presentation.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Sintek Mail">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra superior: busca, sincronização manual, estado, configurações e tema -->
        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="NewMessageButton"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="OnNewMessageClick"
                    AutomationProperties.Name="Nova mensagem"
                    ToolTipService.ToolTip="Nova mensagem (Ctrl+N)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    <TextBlock Text="Nova mensagem" />
                </StackPanel>
            </Button>

            <Grid Grid.Column="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox Grid.Column="0"
                                x:Name="SearchBox"
                                QueryIcon="Find"
                                PlaceholderText="Pesquisar em todas as contas (Ctrl+E)"
                                AutomationProperties.Name="Campo de pesquisa"
                                Text="{x:Bind Search.SearchText, Mode=TwoWay}"
                                QuerySubmitted="OnSearchSubmitted" />

                <!-- Pesquisa avançada: os filtros da seção 6.4 e as pesquisas salvas -->
                <Button Grid.Column="1"
                        x:Name="FiltersButton"
                        AutomationProperties.Name="Filtros de pesquisa avançada"
                        ToolTipService.ToolTip="Filtros de pesquisa avançada">
                    <FontIcon Glyph="&#xE71C;" FontSize="16" />
                    <Button.Flyout>
                        <Flyout x:Name="FiltersFlyout"
                                Placement="BottomEdgeAlignedRight"
                                Opening="OnFiltersFlyoutOpening"
                                Closed="OnFiltersFlyoutClosed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                <StackPanel Spacing="8" Width="360">

                                    <InfoBar IsOpen="{x:Bind Search.HasStatusMessage, Mode=OneWay}"
                                             Severity="Warning"
                                             Message="{x:Bind Search.StatusMessage, Mode=OneWay}"
                                             IsClosable="False" />

                                    <TextBox Header="Remetente"
                                             Text="{x:Bind Search.FromFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Filtro por remetente" />

                                    <TextBox Header="Destinatário (Para)"
                                             Text="{x:Bind Search.RecipientFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Filtro por destinatário" />

                                    <TextBox Header="Em cópia (CC)"
                                             Text="{x:Bind Search.CcFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Filtro por cópia" />

                                    <TextBox Header="Assunto"
                                             Text="{x:Bind Search.SubjectFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Filtro por assunto" />

                                    <TextBox Header="Corpo da mensagem"
                                             Text="{x:Bind Search.BodyFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Filtro por corpo" />

                                    <TextBox Header="Nome do anexo"
                                             Text="{x:Bind Search.AttachmentNameFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Filtro por nome de anexo" />

                                    <CalendarDatePicker Header="A partir de"
                                                        HorizontalAlignment="Stretch"
                                                        Date="{x:Bind Search.ReceivedFrom, Mode=TwoWay}"
                                                        AutomationProperties.Name="Data inicial" />

                                    <CalendarDatePicker Header="Até"
                                                        HorizontalAlignment="Stretch"
                                                        Date="{x:Bind Search.ReceivedUntil, Mode=TwoWay}"
                                                        AutomationProperties.Name="Data final" />

                                    <ComboBox Header="Conta"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind Search.AccountOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind Search.SelectedAccount, Mode=TwoWay}"
                                              AutomationProperties.Name="Filtro por conta" />

                                    <ComboBox Header="Diretório de Domínio"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind Search.DomainOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind Search.SelectedDomain, Mode=TwoWay}"
                                              AutomationProperties.Name="Filtro por Diretório de Domínio" />

                                    <ComboBox Header="Categoria"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind Search.CategoryOptions, Mode=OneWay}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind Search.SelectedCategory, Mode=TwoWay}"
                                              AutomationProperties.Name="Filtro por categoria" />

                                    <ComboBox Header="Leitura"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind Search.ReadStates}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind Search.SelectedReadState, Mode=TwoWay}"
                                              AutomationProperties.Name="Filtro por leitura" />

                                    <ComboBox Header="Sinalizador"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind Search.FlagStates}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind Search.SelectedFlagState, Mode=TwoWay}"
                                              AutomationProperties.Name="Filtro por sinalizador" />

                                    <ComboBox Header="Anexos"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind Search.AttachmentStates}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind Search.SelectedAttachmentState, Mode=TwoWay}"
                                              AutomationProperties.Name="Filtro por anexos" />

                                    <ComboBox Header="Importância"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind Search.ImportanceOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind Search.SelectedImportance, Mode=TwoWay}"
                                              AutomationProperties.Name="Filtro por importância" />

                                    <ComboBox Header="Status de sincronização"
                                              HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind Search.SyncStateOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{x:Bind Search.SelectedSyncState, Mode=TwoWay}"
                                              AutomationProperties.Name="Filtro por status de sincronização" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Pesquisar"
                                                Style="{ThemeResource AccentButtonStyle}"
                                                Click="OnApplyFiltersClick" />
                                        <Button Content="Limpar filtros"
                                                Command="{x:Bind Search.ClearFiltersCommand}" />
                                    </StackPanel>

                                    <TextBlock Text="Pesquisas salvas"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />

                                    <ItemsControl ItemsSource="{x:Bind Search.SavedSearches, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SavedSearchItemViewModel">
                                                <Grid ColumnSpacing="8" Padding="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <Button Grid.Column="1"
                                                            Content="Aplicar"
                                                            Click="OnApplySavedSearchClick"
                                                            Tag="{x:Bind}" />

                                                    <Button Grid.Column="2"
                                                            Content="Excluir"
                                                            Click="OnDeleteSavedSearchClick"
                                                            Tag="{x:Bind}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 PlaceholderText="Nome da pesquisa"
                                                 Text="{x:Bind Search.SaveSearchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Nome para salvar a pesquisa" />

                                        <Button Grid.Column="1"
                                                Content="Salvar"
                                                Command="{x:Bind Search.SaveCurrentSearchCommand}"
                                                VerticalAlignment="Bottom" />
                                    </Grid>

                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <!--
                    O indicador de estado tem rótulo de automação dinâmico: quem usa leitor
                    de tela precisa saber que está offline, e um ícone sozinho não comunica isso.
                -->
                <Button x:Name="SyncButton"
                        Command="{x:Bind Shell.SyncNowCommand}"
                        AutomationProperties.Name="Sincronizar agora"
                        AutomationProperties.HelpText="{x:Bind Shell.ConnectivityDescription, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Shell.ConnectivityDescription, Mode=OneWay}">
                    <FontIcon Glyph="&#xE895;" FontSize="16" />
                </Button>

                <Button x:Name="OutboxButton"
                        Click="OnOutboxClick"
                        AutomationProperties.Name="Fila de sincronização"
                        ToolTipService.ToolTip="Operações aguardando sincronização">
                    <InfoBadge x:Name="PendingBadge"
                               Value="{x:Bind Shell.PendingOperationCount, Mode=OneWay}"
                               VerticalAlignment="Center" />
                </Button>

                <ToggleButton x:Name="ThemeToggle"
                              AutomationProperties.Name="Alternar tema claro e escuro"
                              ToolTipService.ToolTip="Alternar tema claro e escuro"
                              Click="OnThemeToggleClick">
                    <FontIcon Glyph="&#xE793;" FontSize="16" />
                </ToggleButton>

                <Button x:Name="SettingsButton"
                        AutomationProperties.Name="Contas e Diretórios de Domínio"
                        ToolTipService.ToolTip="Contas e Diretórios de Domínio"
                        Click="OnSettingsClick">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Faixa de aviso: regra de domínio, erro de sincronização, operações pendentes -->
        <InfoBar Grid.Row="1"
                 x:Name="StatusBar"
                 IsOpen="{x:Bind HasStatusMessage, Mode=OneWay}"
                 Severity="Warning"
                 Message="{x:Bind Shell.StatusMessage, Mode=OneWay}"
                 IsClosable="True" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!--
                Barra lateral: a árvore hierárquica exigida pela especificação.
                Favoritos / Contas e Diretórios → Domínio → Conta → Pastas
            -->
            <controls:TreeView Grid.Column="0"
                               x:Name="NavigationTree"
                               ItemsSource="{x:Bind Shell.NavigationRoots, Mode=OneWay}"
                               SelectionMode="Single"
                               CanDragItems="False"
                               AutomationProperties.Name="Contas, diretórios e pastas"
                               SelectionChanged="OnNavigationSelectionChanged">
                <controls:TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavigationNode">
                        <!--
                            AllowDrop/DragOver/Drop ficam no ITEM, não na árvore: com eles na
                            TreeView, o 'sender' do handler seria a árvore inteira e o
                            DataContext nunca apontaria a pasta sob o cursor.
                        -->
                        <controls:TreeViewItem ItemsSource="{x:Bind Children}"
                                               IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                               AllowDrop="True"
                                               DragOver="OnFolderDragOver"
                                               Drop="OnFolderDrop"
                                               AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                            <controls:TreeViewItem.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Nova subpasta" Click="OnNewSubfolderClick" Tag="{x:Bind}" />
                                    <MenuFlyoutItem Text="Editar pasta" Click="OnEditFolderClick" Tag="{x:Bind}" />
                                    <MenuFlyoutItem Text="Favoritar / remover dos favoritos"
                                                    Click="OnToggleFavoriteClick" Tag="{x:Bind}" />
                                </MenuFlyout>
                            </controls:TreeViewItem.ContextFlyout>
                            <Grid ColumnSpacing="8" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          Glyph="{x:Bind Icon, Mode=OneWay}"
                                          FontSize="14"
                                          VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Title, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <!-- Cadeado indica pasta restrita por Diretório de Domínio -->
                                <FontIcon Grid.Column="2"
                                          Glyph="&#xE72E;"
                                          FontSize="12"
                                          VerticalAlignment="Center"
                                          Visibility="{x:Bind IsDomainRestricted, Mode=OneWay}"
                                          ToolTipService.ToolTip="Pasta restrita por Diretório de Domínio"
                                          AutomationProperties.Name="Pasta restrita por domínio" />

                                <InfoBadge Grid.Column="3"
                                           Value="{x:Bind UnreadCount, Mode=OneWay}"
                                           Visibility="{x:Bind ShowUnreadBadge, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="Mensagens não lidas" />
                            </Grid>
                        </controls:TreeViewItem>
                    </DataTemplate>
                </controls:TreeView.ItemTemplate>
            </controls:TreeView>

            <Border Grid.Column="1" Width="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Painel central: lista de mensagens -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               Text="{x:Bind MessageList.FolderName, Mode=OneWay}" />

                    <!-- Só existe em modo de pesquisa: devolve o painel à pasta selecionada -->
                    <Button Grid.Column="1"
                            Visibility="{x:Bind MessageList.IsSearchResults, Mode=OneWay}"
                            Click="OnCloseSearchClick"
                            AutomationProperties.Name="Fechar resultados da pesquisa"
                            ToolTipService.ToolTip="Fechar resultados da pesquisa">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>

                <ListView Grid.Row="1"
                          x:Name="MessageListView"
                          ItemsSource="{x:Bind MessageList.Messages, Mode=OneWay}"
                          SelectedItem="{x:Bind MessageList.SelectedMessage, Mode=TwoWay}"
                          SelectionMode="Extended"
                          CanDragItems="True"
                          DragItemsStarting="OnMessageDragStarting"
                          SelectionChanged="OnMessageSelectionChanged"
                          AutomationProperties.Name="Lista de mensagens">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageListItemViewModel">
                            <Grid Padding="4,6" RowSpacing="2"
                                  AutomationProperties.Name="{x:Bind AccessibleDescription}">
                                <Grid.ContextFlyout>
                                    <!-- O submenu de categorias é montado na abertura: a
                                         lista vem do banco e muda em tempo de execução -->
                                    <MenuFlyout Opening="OnMessageContextFlyoutOpening">
                                        <MenuFlyoutItem Text="Marcar como spam"
                                                        Click="OnMarkAsSpamClick" Tag="{x:Bind}" />
                                        <MenuFlyoutItem Text="Não é spam"
                                                        Click="OnMarkAsNotSpamClick" Tag="{x:Bind}" />
                                        <MenuFlyoutSubItem Text="Categorizar" Tag="{x:Bind}" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{x:Bind From}"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="SemiBold" />

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{x:Bind DisplayDate}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                           Text="{x:Bind Subject}"
                                           TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Preview}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />

                                    <FontIcon Glyph="&#xE723;" FontSize="12"
                                              Visibility="{x:Bind HasAttachments}"
                                              AutomationProperties.Name="Com anexo" />

                                    <FontIcon Glyph="&#xE7C1;" FontSize="12"
                                              Visibility="{x:Bind IsFlagged, Mode=OneWay}"
                                              AutomationProperties.Name="Sinalizada" />

                                    <!-- Indicador de que a alteração ainda não chegou ao servidor -->
                                    <FontIcon Glyph="&#xE895;" FontSize="12"
                                              Visibility="{x:Bind HasPendingChanges, Mode=OneWay}"
                                              AutomationProperties.Name="Aguardando sincronização" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="3" Width="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Painel de leitura -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,12" Spacing="4">
                    <TextBlock Text="{x:Bind Reading.Subject, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               TextWrapping="Wrap" />

                    <!--
                        Só os vereditos negativos ganham faixa; o selo de verificada fica
                        discreto. Alerta que aparece em toda mensagem legítima deixa de ser
                        lido.
                    -->
                    <InfoBar IsOpen="{x:Bind Reading.ShowTrustWarning, Mode=OneWay}"
                             Severity="Error"
                             Title="Atenção à procedência"
                             Message="{x:Bind Reading.TrustMessage, Mode=OneWay}"
                             IsClosable="False" />

                    <StackPanel Orientation="Horizontal" Spacing="6"
                                Visibility="{x:Bind Reading.ShowAuthenticatedBadge, Mode=OneWay}">
                        <FontIcon Glyph="&#xE73E;" FontSize="12"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Origem verificada pelo servidor"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <InfoBar IsOpen="{x:Bind Reading.HasDownloadError, Mode=OneWay}"
                             Severity="Warning"
                             Message="{x:Bind Reading.DownloadError, Mode=OneWay}"
                             IsClosable="False" />
                    <TextBlock Text="{x:Bind Reading.From, Mode=OneWay}"
                               Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock Text="{x:Bind Reading.To, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left">
                    <AppBarButton Icon="MailReply" Label="Responder" Click="OnReplyClick" AutomationProperties.Name="Responder (Ctrl+R)" />
                    <AppBarButton Icon="MailReplyAll" Label="Responder a todos" Click="OnReplyAllClick" />
                    <AppBarButton Icon="MailForward" Label="Encaminhar" Click="OnForwardClick" />
                    <AppBarSeparator />
                    <AppBarButton Icon="Delete" Label="Excluir" />
                    <AppBarButton Icon="Save" Label="Arquivar" />
                    <AppBarButton Icon="Tag" Label="Categorizar" />
                </CommandBar>

                <!--
                    Barra de imagens remotas: só aparece quando a mensagem as contém e o
                    usuário ainda não autorizou. Carregá-las confirma ao remetente que a
                    mensagem foi aberta.
                -->
                <InfoBar Grid.Row="2"
                         IsOpen="{x:Bind Reading.ShowRemoteContentBar, Mode=OneWay}"
                         Severity="Informational"
                         Message="Esta mensagem contém imagens externas que foram bloqueadas para proteger sua privacidade."
                         IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button Content="Exibir imagens"
                                Command="{x:Bind Reading.AllowRemoteContentCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <!--
                    WebView2 é a segunda camada de defesa: o HTML já chega higienizado, e
                    aqui scripts e navegação também ficam desativados. Nenhuma das duas
                    camadas sozinha é suficiente.
                -->
                <controls:WebView2 Grid.Row="3"
                                   x:Name="MessageBodyView"
                                   AutomationProperties.Name="Conteúdo da mensagem" />

                <ScrollViewer Grid.Row="4"
                              Margin="16,8"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled">
                <ItemsControl ItemsSource="{x:Bind Reading.Attachments, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AttachmentViewModel">
                            <Button Margin="0,0,8,8"
                                    Click="OnAttachmentClick"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind FileName}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE723;" FontSize="14" />
                                    <TextBlock Text="{x:Bind FileName}" />
                                    <TextBlock Text="{x:Bind DisplaySize}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <!-- Aviso de extensão perigosa, exigido pela especificação -->
                                    <FontIcon Glyph="&#xE7BA;"
                                              FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                              Visibility="{x:Bind IsSuspicious}"
                                              ToolTipService.ToolTip="Este tipo de arquivo pode executar código. Abra apenas se confiar no remetente."
                                              AutomationProperties.Name="Anexo potencialmente perigoso" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
