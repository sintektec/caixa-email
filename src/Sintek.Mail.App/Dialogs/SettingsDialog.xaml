<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sintek.Mail.App.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sintek.Mail.Presentation.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Contas e Diretórios de Domínio"
    CloseButtonText="Fechar"
    DefaultButton="Close">

    <Grid Width="560" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button Content="Adicionar conta" Click="OnAddAccountClick"
                    Style="{ThemeResource AccentButtonStyle}" />
            <Button Content="Novo Diretório de Domínio" Click="OnNewDirectoryClick" />
        </StackPanel>

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 Severity="Warning"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 IsClosable="False" />

        <ListView Grid.Row="2"
                  MaxHeight="360"
                  ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}"
                  SelectionMode="Single"
                  AutomationProperties.Name="Contas cadastradas">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:AccountListItemViewModel">
                    <Grid Padding="4,6" RowSpacing="2" ColumnSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{x:Bind EmailAddress}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind DomainName}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{x:Bind StatusDescription, Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Remoção em duas etapas: o impacto é medido e exibido antes da confirmação -->
        <StackPanel Grid.Row="3" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Ativar ou desativar"
                        Click="OnToggleAccountClick"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />

                <Button Content="Remover conta"
                        Click="OnPrepareRemovalClick"
                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.HasPendingRemoval, Mode=OneWay}"
                     Severity="Error"
                     Title="Confirmar remoção"
                     Message="{x:Bind ViewModel.RemovalSummary, Mode=OneWay}"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Remover definitivamente" Click="OnConfirmRemovalClick" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
    </Grid>
</ContentDialog>
