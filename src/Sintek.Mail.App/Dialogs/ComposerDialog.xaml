<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sintek.Mail.App.Dialogs.ComposerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Sintek.Mail.Presentation.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Nova mensagem"
    PrimaryButtonText="Enviar"
    SecondaryButtonText="Salvar rascunho"
    CloseButtonText="Descartar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSendClick"
    SecondaryButtonClick="OnSaveDraftClick"
    Opened="OnDialogOpened"
    Closed="OnDialogClosed">

    <ContentDialog.Resources>
        <!--
            O aviso de domínio aparece ao lado da sugestão, e a sugestão continua na lista:
            esconder o endereço externo quebraria o trabalho legítimo, e não marcá-lo
            deixaria enviar para um domínio sósia sem perceber.
        -->
        <DataTemplate x:Key="RecipientSuggestionTemplate" x:DataType="vm:RecipientSuggestionItem">
            <Grid ColumnSpacing="8" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{x:Bind DisplayText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1"
                           Text="{x:Bind DomainWarning}"
                           Visibility="{x:Bind IsOutsideAccountDomain}"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="{x:Bind SourceLabel}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
        <StackPanel Spacing="12" Width="560">

            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         AutomationProperties.Name="Operação em andamento" />

            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="Warning"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="False" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    AutoSuggestBox, não TextBox: as sugestões vêm do catálogo de contatos e
                    do histórico de quem já recebeu mensagem. A lista é montada pelo
                    ViewModel, que também decide o que é sugerido e em que ordem.
                -->
                <AutoSuggestBox Grid.Column="0"
                                x:Name="ToBox"
                                Header="Para"
                                PlaceholderText="destinatario@dominio.com.br; outro@dominio.com.br"
                                Text="{x:Bind ViewModel.To, Mode=TwoWay}"
                                ItemsSource="{x:Bind ViewModel.RecipientSuggestions, Mode=OneWay}"
                            TextMemberPath="Address"
                                ItemTemplate="{StaticResource RecipientSuggestionTemplate}"
                                TextChanged="OnToTextChanged"
                                QuerySubmitted="OnToQuerySubmitted"
                                AutomationProperties.Name="Destinatários" />

                <ToggleButton Grid.Column="1"
                              Content="CC/CCO"
                              VerticalAlignment="Bottom"
                              IsChecked="{x:Bind ViewModel.ShowCcBcc, Mode=TwoWay}"
                              AutomationProperties.Name="Exibir campos de cópia e cópia oculta" />
            </Grid>

            <AutoSuggestBox x:Name="CcBox"
                            Header="CC"
                            Text="{x:Bind ViewModel.Cc, Mode=TwoWay}"
                            ItemsSource="{x:Bind ViewModel.RecipientSuggestions, Mode=OneWay}"
                            TextMemberPath="Address"
                            ItemTemplate="{StaticResource RecipientSuggestionTemplate}"
                            TextChanged="OnCcTextChanged"
                            QuerySubmitted="OnCcQuerySubmitted"
                            Visibility="{x:Bind ViewModel.ShowCcBcc, Mode=OneWay}"
                            AutomationProperties.Name="Cópia" />

            <AutoSuggestBox x:Name="BccBox"
                            Header="CCO"
                            Text="{x:Bind ViewModel.Bcc, Mode=TwoWay}"
                            ItemsSource="{x:Bind ViewModel.RecipientSuggestions, Mode=OneWay}"
                            TextMemberPath="Address"
                            ItemTemplate="{StaticResource RecipientSuggestionTemplate}"
                            TextChanged="OnBccTextChanged"
                            QuerySubmitted="OnBccQuerySubmitted"
                            Visibility="{x:Bind ViewModel.ShowCcBcc, Mode=OneWay}"
                            AutomationProperties.Name="Cópia oculta" />

            <TextBox Header="Assunto"
                     Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Assunto" />

            <!--
                Editor rico: WebView2 com contenteditable. A barra chama execCommand via
                ExecuteScriptAsync; o HTML resultante volta ao ViewModel antes de enviar,
                salvar ou gravar o rascunho automático.
            -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Click="OnFormatBoldClick"
                            AutomationProperties.Name="Negrito"
                            ToolTipService.ToolTip="Negrito (Ctrl+B)">
                        <FontIcon Glyph="&#xE8DD;" FontSize="14" />
                    </Button>
                    <Button Click="OnFormatItalicClick"
                            AutomationProperties.Name="Itálico"
                            ToolTipService.ToolTip="Itálico (Ctrl+I)">
                        <FontIcon Glyph="&#xE8DB;" FontSize="14" />
                    </Button>
                    <Button Click="OnFormatUnderlineClick"
                            AutomationProperties.Name="Sublinhado"
                            ToolTipService.ToolTip="Sublinhado (Ctrl+U)">
                        <FontIcon Glyph="&#xE8DC;" FontSize="14" />
                    </Button>
                    <Button Click="OnFormatListClick"
                            AutomationProperties.Name="Lista com marcadores"
                            ToolTipService.ToolTip="Lista com marcadores">
                        <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                    </Button>
                    <Button Click="OnFormatClearClick"
                            AutomationProperties.Name="Limpar formatação"
                            ToolTipService.ToolTip="Limpar formatação">
                        <FontIcon Glyph="&#xE894;" FontSize="14" />
                    </Button>
                </StackPanel>

                <controls:WebView2 x:Name="EditorView"
                                   MinHeight="220"
                                   MaxHeight="320"
                                   AutomationProperties.Name="Corpo da mensagem" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Anexar arquivo"
                        Click="OnAttachClick"
                        AutomationProperties.Name="Anexar arquivo" />

                <CheckBox Content="Confirmação de leitura"
                          IsChecked="{x:Bind ViewModel.RequestReadReceipt, Mode=TwoWay}" />

                <CheckBox Content="Agendar envio"
                          IsChecked="{x:Bind ViewModel.IsSendScheduled, Mode=TwoWay}"
                          AutomationProperties.Name="Agendar o envio para mais tarde" />

                <ComboBox x:Name="TemplatePicker"
                          PlaceholderText="Modelo de mensagem"
                          MinWidth="180"
                          ItemsSource="{x:Bind ViewModel.TemplateOptions, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          AutomationProperties.Name="Modelo de mensagem" />

                <Button Content="Aplicar modelo"
                        Click="OnApplyTemplateClick"
                        AutomationProperties.Name="Aplicar o modelo escolhido" />

                <Button Content="Reescrever com IA"
                        Click="OnRewriteClick"
                        Visibility="{x:Bind Assistant.IsAvailable, Mode=OneWay}"
                        AutomationProperties.Name="Reescrever o texto com o assistente" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind Assistant.HasStatusMessage, Mode=OneWay}"
                     Severity="Informational"
                     Message="{x:Bind Assistant.StatusMessage, Mode=OneWay}"
                     IsClosable="True" />

            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsSendScheduled, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <CalendarDatePicker Grid.Column="0"
                                    Header="Data do envio"
                                    HorizontalAlignment="Stretch"
                                    Date="{x:Bind ViewModel.ScheduledDate, Mode=TwoWay}"
                                    AutomationProperties.Name="Data do envio agendado" />

                <TimePicker Grid.Column="1"
                            Header="Hora"
                            HorizontalAlignment="Stretch"
                            Time="{x:Bind ViewModel.ScheduledTime, Mode=TwoWay}"
                            AutomationProperties.Name="Hora do envio agendado" />
            </Grid>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Attachments, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ComposerAttachmentItem">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE723;" FontSize="14" />

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind FileName}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="2"
                                    Content="Remover"
                                    Click="OnRemoveAttachmentClick"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="Remover anexo" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
