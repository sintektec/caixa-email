<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sintek.Mail.App.Dialogs.OrganizationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sintek.Mail.Presentation.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Categorias, modelos e remetentes"
    CloseButtonText="Fechar"
    DefaultButton="Close">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
        <StackPanel Spacing="12" Width="560">

            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="Warning"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="False" />

            <!-- Categorias -->
            <TextBlock Text="Categorias" Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategoryListItemViewModel">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{x:Bind ColorHex}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="2" Content="Editar"
                                    Click="OnEditCategoryClick" Tag="{x:Bind}" />
                            <Button Grid.Column="3" Content="Excluir"
                                    Click="OnDeleteCategoryClick" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         PlaceholderText="Nome da categoria"
                         Text="{x:Bind ViewModel.CategoryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Nome da categoria" />

                <TextBox Grid.Column="1"
                         PlaceholderText="#0078D4"
                         Text="{x:Bind ViewModel.CategoryColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Cor da categoria" />

                <NumberBox Grid.Column="2"
                           PlaceholderText="Atalho"
                           Minimum="1" Maximum="9"
                           Value="{x:Bind ViewModel.CategoryShortcut, Mode=TwoWay}"
                           AutomationProperties.Name="Atalho da categoria" />

                <Button Grid.Column="3" Content="Salvar"
                        Command="{x:Bind ViewModel.SaveCategoryCommand}" />
            </Grid>

            <!-- Modelos de mensagem -->
            <TextBlock Text="Modelos de mensagem" Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Templates, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TemplateListItemViewModel">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="1" Content="Editar"
                                    Click="OnEditTemplateClick" Tag="{x:Bind}" />
                            <Button Grid.Column="2" Content="Excluir"
                                    Click="OnDeleteTemplateClick" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox PlaceholderText="Nome do modelo"
                     Text="{x:Bind ViewModel.TemplateName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Nome do modelo" />

            <TextBox PlaceholderText="Assunto pré-preenchido"
                     Text="{x:Bind ViewModel.TemplateSubject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Assunto do modelo" />

            <TextBox PlaceholderText="Corpo do modelo (HTML ou texto)"
                     Text="{x:Bind ViewModel.TemplateBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="80"
                     MaxHeight="140"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Corpo do modelo" />

            <Button Content="Salvar modelo" Command="{x:Bind ViewModel.SaveTemplateCommand}" />

            <!-- Remetentes bloqueados -->
            <TextBlock Text="Remetentes bloqueados — vão direto para o lixo eletrônico"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.BlockedSenders, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SenderListItemViewModel">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Target}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Remover"
                                    Click="OnDeleteSenderClick" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         PlaceholderText="endereco@dominio.com ou dominio.com"
                         Text="{x:Bind ViewModel.NewBlockedTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Remetente ou domínio a bloquear" />

                <Button Grid.Column="1" Content="Bloquear"
                        Command="{x:Bind ViewModel.AddBlockedSenderCommand}" />
            </Grid>

            <!-- Remetentes confiáveis -->
            <TextBlock Text="Remetentes confiáveis — imagens remotas liberadas sem perguntar"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.TrustedSenders, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SenderListItemViewModel">
                        <Grid ColumnSpacing="8" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Target}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Remover"
                                    Click="OnDeleteSenderClick" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         PlaceholderText="endereco@dominio.com ou dominio.com"
                         Text="{x:Bind ViewModel.NewTrustedTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Remetente ou domínio confiável" />

                <Button Grid.Column="1" Content="Confiar"
                        Command="{x:Bind ViewModel.AddTrustedSenderCommand}" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
