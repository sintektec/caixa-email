<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sintek.Mail.App.Dialogs.FolderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Pasta"
    PrimaryButtonText="Salvar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnSaveClick">

    <StackPanel Spacing="12" Width="440">

        <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                 Severity="Warning"
                 Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 IsClosable="False" />

        <TextBox Header="Nome da pasta"
                 Text="{x:Bind ViewModel.FolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Nome da pasta" />

        <!--
            O vínculo é a regra central do produto aplicada à pasta: mensagens que não
            pertencem ao domínio escolhido não entram nela, e as subpastas herdam.
        -->
        <ComboBox Header="Vincular a Diretório de Domínio"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.RestrictionChoices, Mode=OneWay}"
                  DisplayMemberPath="Label"
                  SelectedItem="{x:Bind ViewModel.SelectedRestriction, Mode=TwoWay}"
                  AutomationProperties.Name="Diretório de Domínio da pasta" />

        <TextBlock Text="As subpastas herdam o vínculo automaticamente. Uma pasta não pode responder a dois diretórios."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />

        <!-- Exclusão em duas etapas, com o impacto medido antes da confirmação -->
        <StackPanel Spacing="8" Visibility="{x:Bind IsEditing, Mode=OneWay}">
            <Button Content="Excluir esta pasta" Click="OnPrepareDeleteClick" />

            <InfoBar IsOpen="{x:Bind ViewModel.HasPendingDelete, Mode=OneWay}"
                     Severity="Error"
                     Title="Confirmar exclusão"
                     Message="{x:Bind ViewModel.DeleteSummary, Mode=OneWay}"
                     IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Excluir definitivamente" Click="OnConfirmDeleteClick" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

    </StackPanel>
</ContentDialog>
