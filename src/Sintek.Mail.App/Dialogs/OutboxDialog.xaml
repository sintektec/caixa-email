<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sintek.Mail.App.Dialogs.OutboxDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sintek.Mail.Presentation.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fila de sincronização"
    CloseButtonText="Fechar"
    DefaultButton="Close">

    <Grid Width="560" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            No modo offline-first o usuário age sobre dados locais e o efeito no servidor
            acontece depois. Sem esta tela, "já enviei" e "ainda não saiu daqui" seriam
            indistinguíveis para ele.
        -->
        <TextBlock Grid.Row="0"
                   Text="Estas operações já valem neste computador e serão aplicadas no servidor quando houver conexão."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />

        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                 Severity="Success"
                 Message="Nada pendente. Tudo já foi aplicado no servidor."
                 IsClosable="False" />

        <ListView Grid.Row="2"
                  MaxHeight="360"
                  ItemsSource="{x:Bind ViewModel.Operations, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedOperation, Mode=TwoWay}"
                  SelectionMode="Single"
                  AutomationProperties.Name="Operações aguardando sincronização">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:OutboxItemViewModel">
                    <Grid Padding="4,6" RowSpacing="2" ColumnSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Row="0" Grid.Column="0"
                                  Glyph="&#xE7BA;"
                                  FontSize="14"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                  Visibility="{x:Bind NeedsAttention}"
                                  AutomationProperties.Name="Exige decisão do usuário" />

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind Description}"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{x:Bind StatusDescription}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="Warning"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="False" />

            <!--
                Cancelar descarta a tentativa de aplicar no servidor; o efeito local
                permanece. O rótulo diz isso porque a confusão entre as duas coisas é o erro
                mais provável nesta tela.
            -->
            <Button Content="Descartar a sincronização da operação selecionada"
                    Click="OnCancelClick"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</ContentDialog>
