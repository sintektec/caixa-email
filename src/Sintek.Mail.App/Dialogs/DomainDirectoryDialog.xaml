<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sintek.Mail.App.Dialogs.DomainDirectoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Diretório de Domínio"
    PrimaryButtonText="Salvar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Spacing="12" Width="480">

            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="Warning"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="False" />

            <!--
                O domínio identifica o diretório e determina quais contas podem entrar nele.
                Trocá-lo depois exige revalidar contas e mensagens, com relatório de impacto
                e confirmação — por isso o campo trava na edição.
            -->
            <TextBox Header="Domínio"
                     PlaceholderText="sintek.com.br"
                     Text="{x:Bind ViewModel.DomainName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
                     AutomationProperties.Name="Domínio representado pelo diretório" />

            <TextBlock Text="{x:Bind ViewModel.DomainNameError, Mode=OneWay}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" />

            <TextBox Header="Descrição"
                     Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Descrição do diretório" />

            <ComboBox Header="Quais participantes precisam pertencer ao domínio"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.ValidationModes}"
                      DisplayMemberPath="Label"
                      SelectedItem="{x:Bind ViewModel.SelectedValidationMode, Mode=TwoWay}"
                      AutomationProperties.Name="Modo de validação de pertencimento" />

            <ComboBox Header="Mensagem incompatível em pasta restrita"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.InvalidEmailActions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{x:Bind ViewModel.SelectedInvalidEmailAction, Mode=TwoWay}"
                      AutomationProperties.Name="Ação para mensagem incompatível" />

            <CheckBox Content="Aceitar contas e mensagens de subdomínios"
                      IsChecked="{x:Bind ViewModel.AllowSubdomains, Mode=TwoWay}" />

            <CheckBox Content="Exibir entre os favoritos"
                      IsChecked="{x:Bind ViewModel.IsFavorite, Mode=TwoWay}" />

            <CheckBox Content="Diretório ativo"
                      IsChecked="{x:Bind ViewModel.IsActive, Mode=TwoWay}" />

            <TextBlock Text="Domínios adicionais aceitos"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="AliasBox"
                         PlaceholderText="sintek.net.br"
                         AutomationProperties.Name="Novo domínio adicional" />

                <Button Grid.Column="1"
                        Content="Adicionar"
                        Click="OnAddAliasClick"
                        VerticalAlignment="Bottom" />
            </Grid>

            <ListView ItemsSource="{x:Bind ViewModel.Aliases, Mode=OneWay}"
                      SelectionMode="Single"
                      MaxHeight="120"
                      x:Name="AliasList"
                      AutomationProperties.Name="Domínios adicionais" />

            <Button Content="Remover domínio adicional selecionado" Click="OnRemoveAliasClick" />

            <!-- Remoção: sempre em duas etapas, com o impacto medido antes da confirmação -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}">
                <Button Content="Remover este Diretório de Domínio"
                        Click="OnPrepareRemovalClick" />

                <InfoBar IsOpen="{x:Bind ViewModel.HasPendingRemoval, Mode=OneWay}"
                         Severity="Error"
                         Title="Confirmar remoção"
                         Message="{x:Bind ViewModel.RemovalSummary, Mode=OneWay}"
                         IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button Content="Remover definitivamente" Click="OnConfirmRemovalClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
