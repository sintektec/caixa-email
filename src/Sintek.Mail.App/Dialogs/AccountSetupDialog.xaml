<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sintek.Mail.App.Dialogs.AccountSetupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Sintek.Mail.Presentation.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Adicionar conta"
    PrimaryButtonText="Continuar"
    SecondaryButtonText="Voltar"
    CloseButtonText="Cancelar"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    SecondaryButtonClick="OnSecondaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Spacing="12" Width="480">

            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         AutomationProperties.Name="Operação em andamento" />

            <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                     Severity="Warning"
                     Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     IsClosable="False" />

            <!-- Etapa 1: endereço e Diretório de Domínio -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsAddressStep, Mode=OneWay}">
                <TextBox Header="Endereço de e-mail"
                         PlaceholderText="contato@sintek.com.br"
                         Text="{x:Bind ViewModel.EmailAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Endereço de e-mail" />

                <TextBox Header="Nome exibido"
                         Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Nome exibido nas mensagens enviadas" />

                <ComboBox Header="Diretório de Domínio"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AvailableDirectories, Mode=OneWay}"
                          DisplayMemberPath="DisplayText"
                          SelectedItem="{x:Bind ViewModel.SelectedDirectory, Mode=TwoWay}"
                          AutomationProperties.Name="Diretório de Domínio ao qual a conta pertence" />

                <!--
                    A conta só entra em um diretório do mesmo domínio. Quando nenhum existe,
                    o caminho é criar o diretório — não afrouxar a regra.
                -->
                <InfoBar IsOpen="{x:Bind ViewModel.NeedsNewDirectory, Mode=OneWay}"
                         Severity="Informational"
                         Title="Nenhum Diretório de Domínio corresponde a este endereço"
                         Message="Crie o diretório do domínio antes de vincular a conta."
                         IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button Content="Criar diretório" Click="OnCreateDirectoryClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <!-- Etapa 2: servidores -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsServersStep, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.DiscoverySourceDescription, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />

                <TextBox Header="Servidor IMAP"
                         Text="{x:Bind ViewModel.ImapHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Servidor IMAP" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <NumberBox Grid.Column="0"
                               Header="Porta"
                               Value="{x:Bind ViewModel.ImapPortValue, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="65535"
                               SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="Porta IMAP" />

                    <ComboBox Grid.Column="1"
                              Header="Proteção"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.SecurityModes}"
                              DisplayMemberPath="Label"
                              SelectedItem="{x:Bind ViewModel.SelectedImapSecurity, Mode=TwoWay}"
                              AutomationProperties.Name="Modo de proteção do IMAP" />
                </Grid>

                <TextBox Header="Servidor SMTP"
                         Text="{x:Bind ViewModel.SmtpHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Servidor SMTP" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <NumberBox Grid.Column="0"
                               Header="Porta"
                               Value="{x:Bind ViewModel.SmtpPortValue, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="65535"
                               SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="Porta SMTP" />

                    <ComboBox Grid.Column="1"
                              Header="Proteção"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.SecurityModes}"
                              DisplayMemberPath="Label"
                              SelectedItem="{x:Bind ViewModel.SelectedSmtpSecurity, Mode=TwoWay}"
                              AutomationProperties.Name="Modo de proteção do SMTP" />
                </Grid>

                <!--
                    Servidor fora do domínio do endereço: hospedagem terceirizada é legítima
                    e comum, e tem exatamente o mesmo formato de um desvio malicioso. Quem
                    decide é o usuário.
                -->
                <CheckBox Content="Confirmo que estes servidores estão corretos, mesmo não pertencendo ao domínio do endereço"
                          IsChecked="{x:Bind ViewModel.ServersConfirmed, Mode=TwoWay}"
                          Visibility="{x:Bind ViewModel.RequiresServerConfirmation, Mode=OneWay}" />
            </StackPanel>

            <!-- Etapa 3: credenciais -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsCredentialsStep, Mode=OneWay}">
                <ComboBox Header="Forma de autenticação"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.AuthenticationOptions}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedAuthentication, Mode=TwoWay}"
                          AutomationProperties.Name="Forma de autenticação" />

                <TextBox Header="Nome de usuário (se diferente do endereço)"
                         Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{x:Bind ViewModel.RequiresPassword, Mode=OneWay}"
                         AutomationProperties.Name="Nome de usuário" />

                <PasswordBox Header="Senha"
                             Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{x:Bind ViewModel.RequiresPassword, Mode=OneWay}"
                             AutomationProperties.Name="Senha da conta" />

                <TextBlock Text="A senha é guardada no Gerenciador de Credenciais do Windows, nunca no banco de dados."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.RequiresPassword, Mode=OneWay}" />

                <InfoBar IsOpen="{x:Bind ViewModel.ShowOAuthWarning, Mode=OneWay}"
                         Severity="Warning"
                         Message="{x:Bind ViewModel.OAuthUnavailableReason, Mode=OneWay}"
                         IsClosable="False"
                         Visibility="{x:Bind ViewModel.ShowOAuthWarning, Mode=OneWay}" />
            </StackPanel>

            <!-- Etapa 4: verificação concluída -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsVerificationStep, Mode=OneWay}">
                <InfoBar IsOpen="True"
                         Severity="Success"
                         Title="Conexão verificada"
                         Message="Os servidores responderam e as credenciais foram aceitas nos dois protocolos."
                         IsClosable="False" />
            </StackPanel>

            <!-- Etapa 5: concluído -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsCompleted, Mode=OneWay}">
                <InfoBar IsOpen="True"
                         Severity="Success"
                         Title="Conta cadastrada"
                         Message="A conta foi vinculada ao Diretório de Domínio e já aparece na árvore de navegação."
                         IsClosable="False" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
